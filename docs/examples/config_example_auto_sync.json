{
  "zotero": {
    "library_id": "your_library_id",
    "library_type": "user",
    "api_key": "your_api_key_here",
    "local": false
  },
  "qdrant": {
    "host": "localhost",
    "port": 6333,
    "collection_name": "zotero_papers"
  },
  "neo4j_graphrag": {
    "enabled": true,
    "uri": "bolt://localhost:7687",
    "username": "neo4j",
    "password": "demodemo",
    "database": "neo4j"
  },
  "auto_sync": {
    "enabled": true,
    "mode": "hybrid",
    "polling": {
      "interval_seconds": 300,
      "use_since_param": true
    },
    "watcher": {
      "enabled": true,
      "debounce_seconds": 30,
      "watch_path": "/Users/USERNAME/zotero_database/zotero.sqlite"
    },
    "queue": {
      "dedup_window_seconds": 60,
      "max_batch_size": 50
    }
  }
}
